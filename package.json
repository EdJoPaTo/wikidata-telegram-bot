{
	"name": "wikidata-telegram-bot",
	"private": true,
	"version": "2.1.3",
	"description": "Quick Look on Wikidata Entities via Telegram",
	"license": "MIT",
	"repository": "EdJoPaTo/wikidata-telegram-bot",
	"author": {
		"name": "EdJoPaTo",
		"email": "wikidata-telegram-bot@edjopato.de",
		"url": "https://edjopato.de"
	},
	"scripts": {
		"start": "node --enable-source-maps source/wikidata-telegram-bot.ts",
		"test": "tsc && xo"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm"
		}
	},
	"dependencies": {
		"@grammyjs/i18n": "^1.0.1",
		"@grammyjs/storage-file": "^2.0.0",
		"array-filter-unique": "^3.0.2",
		"grammy": "^1.20.3",
		"grammy-inline-menu": "^9.0.0",
		"locale-emoji": "^0.3.0",
		"telegraf-middleware-console-time": "^3.0.0",
		"telegraf-wikibase": "^0.13.0",
		"telegram-format": "^3.0.0",
		"wikibase-sdk": "^9.2.2"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"typescript": "^5.9.3",
		"xo": "^1.2.3"
	},
	"xo": {
		"rules": {
			"@typescript-eslint/naming-convention": "off",
			"unicorn/prevent-abbreviations": "off"
		}
	}
}
